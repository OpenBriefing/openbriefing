{
  "name": "openbriefing",
  "version": "0.5.0",
  "description": "Open Briefing Standard (OBS): the reference parser, the checker and the publisher's tag tools for publishers' own summaries.",
  "keywords": [
    "open-briefing-standard",
    "obs",
    "summary",
    "metadata",
    "opengraph",
    "publishing"
  ],
  "homepage": "https://openbriefingstandard.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenBriefing/openbriefing.git",
    "directory": "packages/openbriefing"
  },
  "bugs": "https://github.com/OpenBriefing/openbriefing/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./briefing": {
      "types": "./dist/briefing.d.ts",
      "import": "./dist/briefing.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "bin": {
    "openbriefing": "dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "kit",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node ../../scripts/make-fixtures.mjs",
    "expected": "tsx scripts/write-expected.ts",
    "prepack": "rm -rf fixtures kit && cp -R ../../spec/fixtures fixtures && mkdir kit && cp ../../kit/prompt.md kit/prompt.md && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "jsdom": "^26.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}

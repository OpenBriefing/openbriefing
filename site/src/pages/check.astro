---
import Base from "../layouts/Base.astro";
import "../styles/card.css";
---

<Base title="Check a page" description="See what a tool reads from your page's Open Briefing Standard tags, and hear the summary aloud." path="/check">
  <div class="prose intro">
    <h1>Check a page</h1>
    <p class="lede">See what a tool reads from your tags, with the card it could show and the summary read aloud.</p>
  </div>

  <form id="check-form" class="checker" novalidate>
    <label for="check-url">The page's address, or a feed's</label>
    <div class="field">
      <input id="check-url" name="url" type="url" inputmode="url" autocomplete="url" placeholder="https://example.com/a-post/" />
      <button id="check-run" type="submit">Check this page</button>
    </div>
    <p class="note">
      No page to hand? Try an example:{" "}<button type="button" class="linkish" data-example="/examples/full-set.html">every tag</button>,{" "}<button type="button" class="linkish" data-example="/examples/one-summary.html">one summary</button>{" "}or{" "}<button type="button" class="linkish" data-example="/examples/verbatim.html">words locked as written</button>.
    </p>

    <details class="paste">
      <summary>Or paste the page's source</summary>
      <p class="note">For a draft, a local page or a page behind a login. Pasted text is checked in your browser and is sent nowhere.</p>
      <label for="check-source" class="visually-hidden">The page's HTML, or a feed's XML</label>
      <textarea id="check-source" name="source" spellcheck="false" placeholder="<!doctype html> …"></textarea>
      <label for="check-source-url">The page's address, if it has no canonical link (optional)</label>
      <input id="check-source-url" type="url" inputmode="url" placeholder="https://example.com/a-post/" />
      <p><button type="submit" class="quiet">Check the pasted source</button></p>
    </details>
    <p id="check-status" class="visually-hidden" role="status" aria-live="polite"></p>
  </form>

  <div id="check-result" class="result" tabindex="-1"></div>

  <noscript><p class="prose">The checker runs in your browser and needs JavaScript. Without it, use <code>npx openbriefing check &lt;address&gt;</code>.</p></noscript>

  <div class="prose after">
    <h2>What happens to the address</h2>
    <p>
      Your browser cannot read another site's page, so a small helper fetches it for you and hands the text back. It reads
      public web pages and feeds only, keeps nothing and logs no address. The tags are read in your browser by the same
      parser the command line uses.
    </p>
    <pre><code>npx openbriefing check https://example.com/a-post/</code></pre>
  </div>
</Base>

<script src="../scripts/checker.ts"></script>

<style is:global>
  .intro h1 {
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.6rem);
  }
  .intro .lede {
    margin-top: 1rem;
  }
  .checker {
    margin-top: 2.2rem;
    max-width: 44rem;
  }
  .checker > label,
  .checker .paste label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .checker .note {
    margin-top: 0.8rem;
  }
  .checker .linkish {
    all: unset;
    cursor: pointer;
    color: var(--pencil);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .checker .linkish:focus-visible {
    outline: 3px solid var(--pencil);
    outline-offset: 2px;
  }
  .checker .paste {
    margin-top: 1.6rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
  .checker .paste > summary {
    cursor: pointer;
    font-weight: 600;
  }
  .checker .paste textarea {
    margin: 0.9rem 0 1rem;
  }
  .checker .paste input {
    width: 100%;
  }
  .checker .paste p {
    margin-top: 1rem;
  }

  .result {
    margin-top: 3rem;
    max-width: 46rem;
    scroll-margin-top: 1.5rem;
  }
  .result:empty {
    display: none;
  }
  .result:focus {
    outline: none;
  }
  .result .checked-url {
    color: var(--slate);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }
  .result .verdict {
    font-family: var(--display);
    font-weight: 650;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    padding-left: 0.9rem;
    border-left: 6px solid var(--line);
  }
  .result .verdict a {
    font-weight: 500;
  }
  .result .verdict-ok {
    border-left-color: var(--ok);
  }
  .result .verdict-bad {
    border-left-color: var(--bad);
  }
  .result .messages {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
  }
  .result .msg {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .result .msg-kind {
    font-weight: 600;
  }
  .result .msg-error .msg-kind {
    color: var(--bad);
  }
  .result .msg-warning .msg-kind {
    color: var(--warn);
  }
  .result-section {
    margin-top: 2.6rem;
  }
  .result-section > h3 {
    margin-bottom: 0.9rem;
  }
  .result-section > * + * {
    margin-top: 0.8rem;
  }
  .result th[scope="row"] {
    color: var(--ink);
    border-bottom-color: var(--line);
    white-space: normal;
    width: 13rem;
    font-weight: 600;
  }
  .result .size-in {
    color: var(--ok);
  }
  .result .size-under,
  .result .size-over {
    color: var(--warn);
    font-weight: 600;
  }
  .result .fulltext > summary,
  .result .feed-item > summary {
    cursor: pointer;
  }
  .result .summary-text {
    white-space: pre-line;
    margin-top: 0.7rem;
    padding-left: 1rem;
    border-left: 3px solid var(--line);
    max-width: var(--measure);
  }
  .result .keeps,
  .result .highlights {
    padding-left: 1.3rem;
    margin: 0;
  }
  .result .highlights {
    list-style: none;
    padding-left: 0;
  }
  .result .keeps li + li,
  .result .highlights li + li {
    margin-top: 0.75rem;
  }
  .result .keep-line {
    text-decoration: underline;
    text-decoration-color: var(--pencil);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .result .highlights li {
    line-height: 1.75;
  }
  .result .brief-card .listen {
    padding: 0.35rem 0.9rem;
    font-size: 0.92rem;
  }
  .result .feed-item {
    border-bottom: 1px solid var(--line);
    padding: 0.85rem 0;
  }
  .result .feed-item-title {
    font-weight: 600;
  }
  .result .state-usable {
    color: var(--ok);
  }
  .result .state-not-usable {
    color: var(--bad);
  }
  .after {
    margin-top: 4rem;
  }
  @media (max-width: 34rem) {
    .result .msg {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
    .result th[scope="row"] {
      width: 8.5rem;
    }
  }
</style>
